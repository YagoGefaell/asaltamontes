{
  "openapi": "3.0.3",
  "info": {
    "title": "Asaltamontes API",
    "version": "0.6.0",
    "description": "API contract between frontend and backend for data exchange"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register new user",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "example": "runner123" },
                  "email": { "type": "string", "example": "runner@example.com" },
                  "password": { "type": "string", "example": "SuperSecret123" },
                  "fullName": { "type": "string", "example": "María Runner" }
                }
              }
            }
          }
        },
        "responses": {
          "429": { "description": "Too many attempts (rate limiting); see the Retry-After header" },
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Invalid fields (Bean Validation, errors per field). A username/email already taken or a confirmPassword mismatch answers 409 with the same errors map",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": { "type": "string", "example": "email" },
                          "message": { "type": "string", "example": "Email already in use" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
    "/auth/google": {
      "post": {
        "summary": "Google OAuth2 login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string", "example": "4/0AX4XfWh..." }
                },
                "required": ["code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Google login",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token in HttpOnly cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid Google code"
          }
        }
      }
    },
    "/api/conversations/private": {
      "get": {
        "summary": "Get private conversation by username",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "runner123" }
                },
                "required": ["username"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private conversation found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" }
              }
            }
          },
          "404": { "description": "Conversation not found" }
        }
      }
    },
    "/api/conversations/group": {
      "post": {
        "summary": "Create group conversation",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "groupName": { "type": "string", "example": "Trail Runners" },
                  "groupImage": { "type": "string", "example": "https://example.com/group.jpg" },
                  "users": {
                    "type": "array",
                    "items": { "type": "string", "example": "runner123" }
                  }
                },
                "required": ["groupName", "users"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group conversation created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "runner123" },
                  "password": { "type": "string", "example": "SuperSecret123" }
                }
              }
            }
          }
        },
        "responses": {
          "429": { "description": "Too many attempts (rate limiting); see the Retry-After header" },
          "200": {
            "description": "Successful login",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token in HttpOnly cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/users/me/sessions/revoke-all": {
      "post": {
        "summary": "Log out on every device",
        "tags": ["Authentication"],
        "description": "Revokes every refresh token of the current user (all devices, including this one) and clears the refreshToken cookie. Access tokens already issued keep working until they expire (15 min).",
        "responses": {
          "204": { "description": "All sessions revoked" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "User logout",
        "tags": ["Authentication"],
        "description": "Revokes the session of the refreshToken cookie (that refresh token stops working) and clears the cookie. Always 200, even without a cookie or with an invalid one.",
        "responses": {
          "200": {
            "description": "Successful logout",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token cookie cleared"
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "tags": ["Authentication"],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": false,
            "schema": { "type": "string" },
            "description": "Refresh token stored in cookie"
          }
        ],
        "responses": {
          "429": { "description": "Too many attempts (rate limiting); see the Retry-After header" },
          "200": {
            "description": "Token successfully refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get authenticated user information",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "integer", "example": 1 },
                    "username": { "type": "string", "example": "runner123" },
                    "email": { "type": "string", "example": "runner@example.com" },
                    "isVerified": { "type": "boolean", "example": true },
                    "fullName": { "type": "string", "example": "María Runner" },
                    "bio": { "type": "string", "example": "Passionate runner" },
                    "city": { "type": "string", "example": "Madrid" },
                    "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" },
                    "runningLevel": { "type": "string", "example": "INTERMEDIATE" },
                    "birthDate": { "type": "string", "format": "date", "example": "1990-05-15" },
                    "phoneNumber": { "type": "string", "example": "+34600000000" },
                    "isPublicProfile": { "type": "boolean", "example": true },
                    "followersCount": { "type": "integer", "example": 150 },
                    "followingCount": { "type": "integer", "example": 200 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "patch": {
        "summary": "Update authenticated user profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "newusername" },
                  "email": { "type": "string", "example": "newemail@example.com" },
                  "fullName": { "type": "string", "example": "María Runner Updated" },
                  "bio": { "type": "string", "example": "New bio" },
                  "city": { "type": "string", "example": "Barcelona" },
                  "profilePictureUrl": { "type": "string", "example": "https://example.com/newpic.jpg" },
                  "isPublicProfile": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/paths/~1api~1users~1me/get/responses/200/content/application~1json/schema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/search": {
      "get": {
        "summary": "Search users",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Search term for username"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "username" },
            "description": "Sort field"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner123" },
                          "fullName": { "type": "string", "example": "María Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" }
                        }
                      }
                    },
                    "pageable": { "type": "object" },
                    "totalPages": { "type": "integer", "example": 5 },
                    "totalElements": { "type": "integer", "example": 100 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/{username}": {
      "get": {
        "summary": "Get user public profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to query"
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": { "type": "string", "example": "runner123" },
                    "isVerified": { "type": "boolean", "example": true },
                    "fullName": { "type": "string", "example": "María Runner" },
                    "bio": { "type": "string", "example": "Passionate runner" },
                    "city": { "type": "string", "example": "Madrid" },
                    "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" },
                    "runningLevel": { "type": "string", "example": "INTERMEDIATE" },
                    "isPublicProfile": { "type": "boolean", "example": true },
                    "isFollowing": { "type": "boolean", "example": false },
                    "followersCount": { "type": "integer", "example": 150 },
                    "followingCount": { "type": "integer", "example": 200 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/users/follow/{username}": {
      "post": {
        "summary": "Follow a user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to follow"
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully followed"
          },
          "400": {
            "description": "Cannot follow yourself or already following this user"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "summary": "Unfollow a user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to unfollow"
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully unfollowed"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found or not following"
          }
        }
      }
    },
    "/api/users/following": {
      "get": {
        "summary": "Get users followed by authenticated user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of followed users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner456" },
                          "fullName": { "type": "string", "example": "Juan Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic2.jpg" },
                          "isFollowing": { "type": "boolean", "example": true }
                        }
                      }
                    },
                    "totalPages": { "type": "integer", "example": 10 },
                    "totalElements": { "type": "integer", "example": 200 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/followers": {
      "get": {
        "summary": "Get authenticated user's followers",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of followers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner789" },
                          "fullName": { "type": "string", "example": "Ana Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic3.jpg" },
                          "isFollowing": { "type": "boolean", "example": false }
                        }
                      }
                    },
                    "totalPages": { "type": "integer", "example": 8 },
                    "totalElements": { "type": "integer", "example": 150 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/conversations/private/{recipientUsername}": {
      "post": {
        "summary": "Get or create private conversation",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "recipientUsername",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the recipient"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation found or created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Recipient user not found"
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "summary": "Get one page of the authenticated user's conversations (cursor)",
        "description": "Most recent first: by lastMessageAt DESC (chats without messages last), then id DESC. For the next page, call again with beforeAt = nextBeforeAt (omit it when null) and beforeId = nextBeforeId. unreadChats counts every chat with unread messages, not only this page (navigation badge).",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "beforeAt",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" },
            "description": "lastMessageAt of the last chat of the previous page (nextBeforeAt). Requires beforeId"
          },
          {
            "name": "beforeId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" },
            "description": "conversationId of the last chat of the previous page (nextBeforeId)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 30, "minimum": 1, "maximum": 100 },
            "description": "Page size (values above 100 are capped)"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of conversation summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/ChatSummary" } },
                    "hasMore": { "type": "boolean" },
                    "nextBeforeAt": { "type": "string", "format": "date-time", "nullable": true },
                    "nextBeforeId": { "type": "integer", "format": "int64", "nullable": true },
                    "unreadChats": { "type": "integer", "format": "int64" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "beforeAt without beforeId"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages": {
      "get": {
        "summary": "Get one page of the conversation history (cursor by message id)",
        "description": "Returns the `limit` messages before `before` (or the latest ones), oldest first. To load older messages, call again with before = nextBefore. Does not mark the conversation as read (use POST .../read or the chat.read STOMP frame). With `after` instead (T11), returns the `limit` messages newer than that id, oldest first; hasMore then means there are newer ones (call again with after = id of the last item) and nextBefore is null.",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Conversation ID"
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Only messages with a smaller id (the nextBefore of the previous page)"
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Only messages with a greater id (catching up after a reconnection). Cannot be combined with before"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 30, "minimum": 1, "maximum": 100 },
            "description": "Page size (values above 100 are capped)"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/MessageDto" } },
                    "hasMore": { "type": "boolean" },
                    "nextBefore": { "type": "integer", "format": "int64", "nullable": true }
                  }
                }
              }
            }
          },
          "400": {
            "description": "before and after in the same request"
          },
          "401": {
            "description": "Not authenticated (missing, invalid or expired access token)"
          },
          "403": {
            "description": "The user is not a participant of the conversation"
          }
        }
      }
    },
    "/api/conversations/{conversationId}/read": {
      "post": {
        "summary": "Mark the conversation as read (unread count to 0)",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Marked as read" },
          "401": { "description": "Not authenticated" },
          "403": { "description": "The user is not a participant of the conversation" }
        }
      }
    },
    "/api/events": {
      "post": {
        "summary": "Create an event (T15a)",
        "description": "The organizer becomes its first attendee (GOING). With communityId only OWNER/MODERATOR members of that community can create it. visibility COMMUNITY requires communityId. timezone defaults to Europe/Madrid.",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateEvent" } } } },
        "responses": {
          "201": { "description": "Created (Location: /api/events/{id})", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventDetails" } } } },
          "400": { "description": "Invalid data (past start, end before start, half coordinates, unknown timezone, COMMUNITY without community…)" },
          "403": { "description": "Not staff of the community" },
          "404": { "description": "Community not found" }
        }
      },
      "get": {
        "summary": "Scheduled events the user can see, soonest first; upcoming by default (T15a, T15c)",
        "description": "All filters are optional and combine with AND. Events of a COMMUNITY-visibility community the user does not belong to (or is banned from) never appear, whatever the filters. Cancelled events are not listed. Events without distance or coordinates never match a distance or bounding-box filter.",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "description": "ISO-8601 instant; default: now", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "description": "ISO-8601 instant; must not be before from", "schema": { "type": "string", "format": "date-time" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["MEETUP", "TRAINING", "RACE", "TRIP"] } },
          { "name": "level", "in": "query", "schema": { "type": "string", "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED", "EXPERT"] } },
          { "name": "communityId", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "city", "in": "query", "description": "Case-insensitive exact match", "schema": { "type": "string" } },
          { "name": "minDistance", "in": "query", "description": "km", "schema": { "type": "number" } },
          { "name": "maxDistance", "in": "query", "description": "km; not below minDistance", "schema": { "type": "number" } },
          { "name": "minLat", "in": "query", "description": "Bounding box: the four of minLat, maxLat, minLng, maxLng or none", "schema": { "type": "number" } },
          { "name": "maxLat", "in": "query", "schema": { "type": "number" } },
          { "name": "minLng", "in": "query", "schema": { "type": "number" } },
          { "name": "maxLng", "in": "query", "schema": { "type": "number" } },
          { "name": "organizer", "in": "query", "description": "Only 'me': events she organizes", "schema": { "type": "string", "enum": ["me"] } },
          { "name": "attending", "in": "query", "description": "Only 'me': events where she is GOING or on the WAITLIST", "schema": { "type": "string", "enum": ["me"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } }
        ],
        "responses": {
          "200": { "description": "Spring Page of EventSummary (includes latitude and longitude of the meeting point, null when the event has none)" },
          "400": { "description": "Invalid filter (unknown enum value, to before from, maxDistance below minDistance, incomplete or inverted bounding box, organizer/attending other than 'me')" }
        }
      }
    },
    "/api/communities/{slug}/events": {
      "get": {
        "summary": "Events of a community the user can see, soonest first; upcoming by default (T15c)",
        "description": "Same visibility rules and filters as GET /api/events (from, to, type, level, city, minDistance, maxDistance, attending), without communityId or bounding box.",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } }
        ],
        "responses": {
          "200": { "description": "Spring Page of EventSummary (includes latitude and longitude of the meeting point, null when the event has none)" },
          "400": { "description": "Invalid filter" },
          "404": { "description": "Community not found" }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "summary": "Event detail with myStatus (GOING, WAITLIST, CANCELLED or null) and canEdit",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "The event", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventDetails" } } } },
          "404": { "description": "Not found, or a COMMUNITY event and the user is not an (unbanned) member" }
        }
      },
      "patch": {
        "summary": "Edit an event: null fields stay as they are; visibility and community cannot change",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "The updated event" },
          "400": { "description": "Invalid data" },
          "403": { "description": "Not the organizer nor community staff" },
          "409": { "description": "Cancelled event, capacity below attendeeCount, or edited by someone else at the same time" }
        }
      }
    },
    "/api/events/{eventId}/cancel": {
      "post": {
        "summary": "Cancel an event (idempotent). Optional body { \"reason\": string ≤ 500 }",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "The event, status CANCELLED" }, "403": { "description": "Not the organizer nor community staff" } }
      }
    },
    "/api/events/{eventId}/join": {
      "post": {
        "summary": "Join an event (T15b): GOING if there is a place, otherwise WAITLIST at the end. Idempotent",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "The event, with myStatus GOING or WAITLIST" },
          "404": { "description": "Not found or not visible" },
          "409": { "description": "Cancelled or already started" }
        }
      }
    },
    "/api/events/{eventId}/leave": {
      "post": {
        "summary": "Leave an event or its waitlist; the first on the waitlist takes the free place. Idempotent",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "The event, myStatus CANCELLED" }, "409": { "description": "The organizer cannot leave her own event" } }
      }
    },
    "/api/events/{eventId}/attendees": {
      "get": {
        "summary": "Attendees by status: GOING (default) in order of arrival, WAITLIST by position",
        "tags": ["Events"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["GOING", "WAITLIST", "CANCELLED"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } }
        ],
        "responses": { "200": { "description": "Spring Page of { username, fullName, profilePictureUrl, status, waitlistPosition, joinedAt }" } }
      }
    },
    "/ws-asaltamontes": {
      "get": {
        "summary": "WebSocket STOMP handshake endpoint",
        "tags": ["Messages", "WebSocket"],
        "description": "STOMP over WebSocket endpoint used for realtime messages. The client connects to this URL and then sends a STOMP CONNECT frame with an Authorization header 'Bearer <accessToken>'. Without a valid access token the server answers an ERROR frame (header 'message': 'Token no proporcionado' / 'Token inválido') and closes the connection. Only /user/queue/** can be subscribed to. Messages are routed by user id, so they keep arriving after a username change.",
        "responses": {
          "101": {
            "description": "Switching Protocols"
          },
          "401": {
            "description": "Invalid or missing token during STOMP CONNECT (sent as a STOMP ERROR frame)"
          }
        },
        "x-stomp": {
          "applicationDestinationPrefix": "/app",
          "userDestinationPrefix": "/user",
          "brokerPrefixes": ["/queue", "/topic"],
          "publish": {
            "destination": "/app/chat.send",
            "payload": {
              "type": "object",
              "required": ["conversationId", "content"],
              "properties": {
                "conversationId": { "type": "integer" },
                "content": { "type": "string", "maxLength": 2000, "description": "Trimmed; empty or longer than 2000 characters is rejected on /user/queue/errors" }
              }
            }
          },
          "subscribe": [
            {
              "destination": "/user/queue/messages",
              "payload": {
                "$ref": "#/components/schemas/PrivateMessage"
              }
            },
            {
              "destination": "/user/queue/errors",
              "description": "Errors of the frames this session sent (e.g. writing to a conversation the user does not belong to). Only the sending session receives them.",
              "payload": {
                "type": "object",
                "properties": {
                  "detail": { "type": "string", "example": "No tienes permiso para escribir en este chat" }
                }
              }
            }
          ]
        }
      }
    },
    "/api/media": {
      "post": {
        "summary": "Upload an image (T17a). Re-encoded as JPEG without EXIF/GPS in three sizes (longest side 128, 640, 1280 px; never enlarged)",
        "tags": ["Media"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "purpose"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "JPEG, PNG or WebP (checked by content), up to 10 MB, 64 to 8000 px per side" },
                  "purpose": { "type": "string", "enum": ["AVATAR", "COMMUNITY_COVER", "GROUP_IMAGE", "EVENT_IMAGE"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "urls": {
                      "type": "object",
                      "properties": {
                        "thumb": { "type": "string", "example": "/media/avatar/0b1c.../thumb.jpg" },
                        "medium": { "type": "string" },
                        "large": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Not a valid image, too small or too big in pixels, unknown purpose or missing file" },
          "401": { "description": "Not authenticated" },
          "413": { "description": "File larger than 10 MB" },
          "429": { "description": "More than 30 uploads in an hour (Retry-After in seconds), or the server is busy processing other images" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEvent": {
        "type": "object",
        "required": ["title", "type", "startsAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 4000 },
          "type": { "type": "string", "enum": ["MEETUP", "TRAINING", "RACE", "TRIP"] },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" },
          "timezone": { "type": "string", "example": "Europe/Madrid" },
          "meetingPointName": { "type": "string", "maxLength": 200 },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "city": { "type": "string", "maxLength": 80 },
          "distanceKm": { "type": "number" },
          "elevationGainM": { "type": "integer" },
          "level": { "type": "string", "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED", "EXPERT"] },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 500, "nullable": true },
          "visibility": { "type": "string", "enum": ["PUBLIC", "COMMUNITY"] },
          "communityId": { "type": "integer", "format": "int64" }
        }
      },
      "EventDetails": {
        "type": "object",
        "description": "CreateEvent fields plus: id, status (SCHEDULED, CANCELLED, FINISHED), attendeeCount, communitySlug, communityName, organizerUsername, organizerFullName, organizerPictureUrl, imageUrl, cancelReason, cancelledAt, myStatus, canEdit"
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "contactUsername": { "type": "string", "example": "runner123" }
        }
      },
      "ChatSummary": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "contactUsername": { "type": "string", "example": "runner123" },
          "unreadCount": { "type": "integer", "example": 3 },
          "lastMessageAt": { "type": "string", "format": "date-time", "example": "2026-03-24T10:15:30" }
        }
      },
      "MessageDto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 5001 },
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "senderUsername": { "type": "string", "example": "runner123" },
          "content": { "type": "string", "example": "Nos vemos a las 7 en el parque" },
          "sentAt": { "type": "string", "format": "date-time", "example": "2026-03-24T10:16:00" }
        }
      },
      "PrivateMessage": {
        "type": "object",
        "required": ["conversationId", "senderUsername", "receiverUsername", "content"],
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "senderUsername": { "type": "string", "example": "runner123" },
          "receiverUsername": { "type": "string", "example": "runner456" },
          "content": { "type": "string", "example": "Hola!" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
}
