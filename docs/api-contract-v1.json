{
  "openapi": "3.0.3",
  "info": {
    "title": "Asaltamontes API",
    "version": "1.0.0",
    "description": "API contract between frontend and backend for data exchange"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register new user",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "username", "email", "password", "confirmPassword"],
                "properties": {
                  "fullName": { "type": "string", "example": "María Runner" },
                  "username": { "type": "string", "example": "runner123" },
                  "email": { "type": "string", "format": "email", "example": "runner@example.com" },
                  "password": { "type": "string", "example": "SuperSecret123" },
                  "confirmPassword": { "type": "string", "example": "SuperSecret123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token in HttpOnly cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "example": 400 },
                    "error": { "type": "string", "example": "Bad Request" },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": { "type": "string", "example": "email" },
                          "message": { "type": "string", "example": "Email already in use" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "runner123" },
                  "password": { "type": "string", "example": "SuperSecret123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token in HttpOnly cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "User logout",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Successful logout",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Refresh token cookie cleared"
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "tags": ["Authentication"],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": false,
            "schema": { "type": "string" },
            "description": "Refresh token stored in cookie"
          }
        ],
        "responses": {
          "200": {
            "description": "Token successfully refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get authenticated user information",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "integer", "example": 1 },
                    "username": { "type": "string", "example": "runner123" },
                    "email": { "type": "string", "example": "runner@example.com" },
                    "isVerified": { "type": "boolean", "example": true },
                    "fullName": { "type": "string", "example": "María Runner" },
                    "bio": { "type": "string", "example": "Passionate runner" },
                    "city": { "type": "string", "example": "Madrid" },
                    "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" },
                    "runningLevel": { "type": "string", "example": "INTERMEDIATE" },
                    "birthDate": { "type": "string", "format": "date", "example": "1990-05-15" },
                    "phoneNumber": { "type": "string", "example": "+34600000000" },
                    "isPublicProfile": { "type": "boolean", "example": true },
                    "followersCount": { "type": "integer", "example": 150 },
                    "followingCount": { "type": "integer", "example": 200 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "patch": {
        "summary": "Update authenticated user profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "newusername" },
                  "email": { "type": "string", "example": "newemail@example.com" },
                  "fullName": { "type": "string", "example": "María Runner Updated" },
                  "bio": { "type": "string", "example": "New bio" },
                  "city": { "type": "string", "example": "Barcelona" },
                  "profilePictureUrl": { "type": "string", "example": "https://example.com/newpic.jpg" },
                  "isPublicProfile": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/paths/~1api~1users~1me/get/responses/200/content/application~1json/schema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/search": {
      "get": {
        "summary": "Search users",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Search term for username"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "username" },
            "description": "Sort field"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner123" },
                          "fullName": { "type": "string", "example": "María Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" }
                        }
                      }
                    },
                    "pageable": { "type": "object" },
                    "totalPages": { "type": "integer", "example": 5 },
                    "totalElements": { "type": "integer", "example": 100 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/{username}": {
      "get": {
        "summary": "Get user public profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to query"
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": { "type": "string", "example": "runner123" },
                    "isVerified": { "type": "boolean", "example": true },
                    "fullName": { "type": "string", "example": "María Runner" },
                    "bio": { "type": "string", "example": "Passionate runner" },
                    "city": { "type": "string", "example": "Madrid" },
                    "profilePictureUrl": { "type": "string", "example": "https://example.com/pic.jpg" },
                    "runningLevel": { "type": "string", "example": "INTERMEDIATE" },
                    "isPublicProfile": { "type": "boolean", "example": true },
                    "isFollowing": { "type": "boolean", "example": false },
                    "followersCount": { "type": "integer", "example": 150 },
                    "followingCount": { "type": "integer", "example": 200 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/users/follow/{username}": {
      "post": {
        "summary": "Follow a user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to follow"
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully followed"
          },
          "400": {
            "description": "Cannot follow yourself or already following this user"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "summary": "Unfollow a user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the user to unfollow"
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully unfollowed"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "User not found or not following"
          }
        }
      }
    },
    "/api/users/following": {
      "get": {
        "summary": "Get users followed by authenticated user",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of followed users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner456" },
                          "fullName": { "type": "string", "example": "Juan Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic2.jpg" },
                          "isFollowing": { "type": "boolean", "example": true }
                        }
                      }
                    },
                    "totalPages": { "type": "integer", "example": 10 },
                    "totalElements": { "type": "integer", "example": 200 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/users/followers": {
      "get": {
        "summary": "Get authenticated user's followers",
        "tags": ["Followers"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of followers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string", "example": "runner789" },
                          "fullName": { "type": "string", "example": "Ana Runner" },
                          "profilePictureUrl": { "type": "string", "example": "https://example.com/pic3.jpg" },
                          "isFollowing": { "type": "boolean", "example": false }
                        }
                      }
                    },
                    "totalPages": { "type": "integer", "example": 8 },
                    "totalElements": { "type": "integer", "example": 150 },
                    "size": { "type": "integer", "example": 20 },
                    "number": { "type": "integer", "example": 0 }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/conversations/private/{recipientUsername}": {
      "post": {
        "summary": "Get or create private conversation",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "recipientUsername",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Username of the recipient"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation found or created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Recipient user not found"
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "summary": "Get authenticated user's conversations",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Conversation summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages": {
      "get": {
        "summary": "Get conversation history",
        "tags": ["Messages"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Conversation ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "500": {
            "description": "Unexpected server error or access denied by server-side validation"
          }
        }
      }
    },
    "/ws-asaltamontes": {
      "get": {
        "summary": "WebSocket STOMP handshake endpoint",
        "tags": ["Messages", "WebSocket"],
        "description": "STOMP over WebSocket endpoint used for realtime private messages. The client connects to this URL and then sends a STOMP CONNECT frame with an Authorization header in format 'Bearer <accessToken>'.",
        "responses": {
          "101": {
            "description": "Switching Protocols"
          },
          "401": {
            "description": "Invalid or missing token during STOMP CONNECT"
          }
        },
        "x-stomp": {
          "applicationDestinationPrefix": "/app",
          "userDestinationPrefix": "/user",
          "brokerPrefixes": ["/queue", "/topic"],
          "publish": {
            "destination": "/app/chat.private",
            "payload": {
              "$ref": "#/components/schemas/PrivateMessage"
            }
          },
          "subscribe": [
            {
              "destination": "/user/queue/messages",
              "payload": {
                "$ref": "#/components/schemas/PrivateMessage"
              }
            }
          ]
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatResponse": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "contactUsername": { "type": "string", "example": "runner123" }
        }
      },
      "ChatSummary": {
        "type": "object",
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "contactUsername": { "type": "string", "example": "runner123" },
          "unreadCount": { "type": "integer", "example": 3 },
          "lastMessageAt": { "type": "string", "format": "date-time", "example": "2026-03-24T10:15:30" }
        }
      },
      "MessageDto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 5001 },
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "senderUsername": { "type": "string", "example": "runner123" },
          "content": { "type": "string", "example": "Nos vemos a las 7 en el parque" },
          "sentAt": { "type": "string", "format": "date-time", "example": "2026-03-24T10:16:00" }
        }
      },
      "PrivateMessage": {
        "type": "object",
        "required": ["conversationId", "senderUsername", "receiverUsername", "content"],
        "properties": {
          "conversationId": { "type": "integer", "format": "int64", "example": 42 },
          "senderUsername": { "type": "string", "example": "runner123" },
          "receiverUsername": { "type": "string", "example": "runner456" },
          "content": { "type": "string", "example": "Hola!" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
