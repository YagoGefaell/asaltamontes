DATABASE_URL=jdbc:postgresql://db:5432/asaltamontes
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password
JWT_SECRET=your_minimum_32_characters_secret_key
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Spring profile for the backend container: prod (default in docker-compose) or dev
SPRING_PROFILES_ACTIVE=prod
# true only when the app is served over HTTPS (refresh token cookie)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
DB_POOL_SIZE=10
# Optional: port of the app (nginx) on the host and JVM options of the backend
FRONTEND_PORT=80
BACKEND_JAVA_OPTS=-Xms128m -Xmx512m
# Optional: folder inside the backend container where uploaded images are stored (volume media_data)
MEDIA_DIR=/data/media
# Optional: daily backup time (server local time) and timezone of the backup service
BACKUP_TIME=03:30
# Optional: how many daily tar.gz copies of the uploaded images to keep (default 3) and the free disk space (MB)
# that must remain after a copy; with less room the copy is skipped (see /backups/media/status)
BACKUP_MEDIA_KEEP=3
BACKUP_MIN_FREE_MB=1024
# Optional: orphan image cleanup (images nobody references), per-user image quota
# MEDIA_CLEANUP_CRON=0 15 4 * * *
# MEDIA_ORPHAN_GRACE_PERIOD=24h
# MEDIA_MAX_BYTES_PER_USER=50MB
# Optional: email (T24a). With MAIL_HOST empty, emails are written to the backend log instead of being sent.
# Resend (see README, "Email"): MAIL_HOST=smtp.resend.com, MAIL_PORT=587, MAIL_USER=resend, MAIL_PASSWORD=<API key>
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=resend
# MAIL_PASSWORD=
# MAIL_FROM=Asaltamontes Female <hola@tudominio.com>
# true: with MAIL_HOST empty, write each email WITH its links in the log (private demo server only; the links log in as anyone)
# MAIL_LOG_BODY=false
# Public URL of the web app (links in emails), e.g. the Tailscale URL
# APP_BASE_URL=http://localhost
# true: accounts without a verified email cannot create communities, events, posts or new chats (turn on only with real email)
# VERIFICATION_ENFORCE=false
TZ=Europe/Madrid
