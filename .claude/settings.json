{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(git push -u origin *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git rev-parse*)",
      "Bash(gh auth status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh api *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose -p asaltamontes-dev *)",
      "Bash(docker compose config*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(docker compose down*)",
      "Bash(docker compose rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-merged-migrations.sh"
          }
        ]
      }
    ]
  }
}
